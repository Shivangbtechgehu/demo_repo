# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# IMPORTANT: If your password contains special characters (@ # $ % : / ? & =)
# you MUST URL-encode them before using in the URI.
# Example: password "my@pass#123" becomes "my%40pass%23123"
# Encoder tool: https://www.urlencoder.org
MONGO_URI=mongodb+srv://username:encodedPassword@cluster0.xxxxx.mongodb.net/roadmap?retryWrites=true&w=majority&appName=Cluster0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_strong_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
APP_ORIGIN=https://your-frontend.vercel.app

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRES_IN_MINUTES=10

# ── Cloudinary (optional — file uploads) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SMTP / Email (optional — OTP emails) ─────────────────────────────────────
# If these are missing, backend still starts but OTP emails will not work.
# Use Gmail App Password (16 chars, no spaces): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your16charapppassword
SMTP_FROM=CareerMap <your_email@gmail.com>

# ── AI Provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=fallback
GEMINI_API_KEY=
